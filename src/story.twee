/* ===== 변수 명세 (시스템 설계: SYSTEM.md 참고) =====
   스탯 = 소프트 게이트(<<gate>>로 특별 선택지 해금). 엔딩 = 플래그 기반(<<flag>>).

   $leon.attachment    애착   0~ : 마틸다에 대한 정. ↑ → 보호/감정 선택지
   $leon.discipline    규율   10~: 프로 정신. ↑ → 냉정/거절/전술 선택지
   $leon.suspicion     경계심 0~ : 위협 감지. ↑ → 함정 간파/선제 대응 선택지
   $mathilda.trust     신뢰   0~ : 레옹을 믿는 정도. ↑ → 협력/고백 선택지
   $mathilda.rage      분노   0~ : 복수심. ↑ → 무모/폭력 선택지
   $mathilda.skill     기술   0~ : 훈련 성취도. ↑ → 작전 참여/사격 선택지
   $stansfield.high    약물   5~ : 도취 상태 (스탠스필드 시점)
   $stansfield.cruelty 잔혹도 0~ : 잔혹함 (스탠스필드 시점)
   $clues              []      : 발견 단서 (<<clue>>로 추가)
   $inventory          []      : 소지품 (<<item>>으로 추가, $inventory.includes()로 체크)
   $endingFlags        {}      : 엔딩 결정 플래그 (<<flag>>로 누적)             */
<<set $perspective to "leon">>
<<set $mathilda to {trust: 0, rage: 0, skill: 0}>>
<<set $leon to {attachment: 0, discipline: 10, suspicion: 0}>>
<<set $stansfield to {high: 5, cruelty: 0}>>
<<set $clues to []>>
<<set $inventory to []>>
<<set $endingFlags to {}>>


